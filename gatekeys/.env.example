# Copy to .env, fill in, then: chmod 600 .env
# .env holds the login to the page that hands out gate keys. It is
# git-ignored; keep it that way.

# The management GUI's login. There is one account, and it is the only thing
# between a browser and a working gate key — see "Security posture" in
# README.md.
GATEKEYS_USER=
GATEKEYS_PASSWORD=

# Signs the session cookie. Any long random string; changing it signs
# everyone out. Generate one with: openssl rand -base64 32
GATEKEYS_SECRET_KEY=

# The shared secret intercom-app presents on /api/verify. The same value goes
# in ../intercom/.env as GATEKEYS_TOKEN. openssl rand -base64 32
GATEKEYS_VERIFY_TOKEN=

# Host port the GUI is published on, and the host address it binds to. On a
# host with a leg on the camera network, set BIND_ADDR to the trusted LAN
# address so this page never appears on the camera side.
PORT=8097
BIND_ADDR=0.0.0.0

# How long a GUI login lasts.
GATEKEYS_SESSION_HOURS=12

# Schedules are evaluated in this timezone, because that is the clock the
# person holding the code reads. E.g. Europe/Amsterdam.
TZ=UTC
