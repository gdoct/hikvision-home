# Copy to .env, fill in, then: chmod 600 .env
# .env holds the credentials that open your gate. It is git-ignored; keep it
# that way.

# ---------------------------------------------------------------- the device
# Address of the Hikvision intercom or door station on your network.
INTERCOM_HOST=192.0.2.10

# ISAPI account. Prefer a dedicated account with only door-unlock and
# live-view rights — not the admin account: this password sits in a file on a
# box that runs other things.
INTERCOM_USER=
INTERCOM_PASSWORD=

# Door number for /ISAPI/AccessControl/RemoteControl/door/<id>. Usually 1.
# Confirm with: docker compose run --rm intercom-app python tools/probe.py
INTERCOM_DOOR_ID=1

# RTSP path. /Streaming/Channels/101 is the main stream, /102 the sub stream
# (lighter, often the better choice for phones). Confirm with probe.py.
RTSP_PATH=/Streaming/Channels/101

# ------------------------------------------------------------------ the page
# Name in the browser tab and on the phone's home screen, e.g. "Front gate".
SITE_NAME=Gate
INTERCOM_NAME=Gate intercom

# ------------------------------------------------------------- camera slots
# Up to MAX_CAMERAS cameras (3 by default, which is what the grid is laid out
# for). Slot 1 is the intercom above; slots 2 and up are optional, and a slot
# with no host simply does not appear on the page.
#
# The login defaults to the intercom's; override per camera where it differs.
# CAMERA<n>_RTSP_PATH defaults to /Streaming/Channels/101 (use /102 for the
# sub stream). Non-Hikvision cameras usually want their own path: TP-Link Tapo
# uses /stream1 (main) or /stream2 (sub), with the "Camera Account" from the
# Tapo app rather than the cloud login.
MAX_CAMERAS=3

CAMERA2_HOST=
CAMERA2_NAME=Camera 2
# CAMERA2_USER=
# CAMERA2_PASSWORD=
# CAMERA2_RTSP_PATH=/Streaming/Channels/101
# CAMERA2_RTSP_PORT=554

CAMERA3_HOST=
CAMERA3_NAME=Camera 3
# CAMERA3_USER=
# CAMERA3_PASSWORD=
# CAMERA3_RTSP_PATH=/Streaming/Channels/101
# CAMERA3_RTSP_PORT=554

# ---------------------------------------------------------------- networking
# Host port the app is published on, and the host address it binds to. On a
# host with a leg on the camera network, set BIND_ADDR to the trusted LAN
# address so the app never appears on the camera side.
PORT=8099
BIND_ADDR=0.0.0.0

# Address go2rtc binds its API to. Must be the gateway of the compose bridge
# network in docker-compose.yml. Leave as is unless that subnet clashes.
GO2RTC_BIND=172.30.9.1

# ------------------------------------------------------------------ the gate
# Refuse a second press for this many seconds after each press.
GATE_COOLDOWN_SECONDS=5

# Timezone used for timestamps in gate.log, e.g. Europe/Amsterdam.
TZ=UTC

# ------------------------------------------------------- QR codes (optional)
# The scanner decodes QR codes held up to the intercom while Frigate reports
# a person at the gate, and asks gatekeys whether the code may open it.
# Leave MQTT_HOST and MQTT_USER empty to switch the scanner off entirely;
# everything else keeps working. There is no fallback: no broker, no scanning.
#
# Use a read-only MQTT account that can subscribe to frigate/events and
# nothing else, so this app cannot send Frigate commands.
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
# Frigate's name for the camera that watches the gate.
QR_FRIGATE_CAMERA=gate
# Frames decoded per second while someone is at the gate.
QR_SCAN_FPS=8
# Keep decoding this long after the last person leaves: go2rtc needs a couple
# of seconds to start its transcode, and a warm stream catches the next
# approach from its first frame.
QR_LINGER_SECONDS=90
# A person Frigate has said nothing about for this long is presumed gone
# (guards against a missed "end" event keeping the scanner on forever), and
# the same code is not logged twice within QR_REPEAT_SECONDS.
# QR_STALE_SECONDS=300
# QR_REPEAT_SECONDS=30
# Keep the last N frames seen with someone at the gate, in /data/qr-frames/,
# to find out why a code did not read. These are stills of whoever stands at
# your gate: switch it on for a debugging session, not as a habit.
QR_DEBUG_FRAMES=0

# ../gatekeys decides whether a decoded code may open the gate. The token must
# equal GATEKEYS_VERIFY_TOKEN there. QR_ACTION=log decodes and logs the
# verdict without opening anything — how to prove this works at your gate
# before trusting it.
GATEKEYS_URL=http://192.0.2.1:8097
GATEKEYS_TOKEN=
QR_ACTION=open
